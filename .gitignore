# Terraform working directory and local plugin cache
.terraform/
.terraform-plugin-cache/

# State — never commit; a real deployment uses a remote backend
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Example output
examples/local/out/

# Editor
.idea/
.vscode/
*.swp
.DS_Store

# Note: .terraform.lock.hcl is intentionally NOT ignored. Committing it pins the
# exact provider versions the suites were verified against, which is what makes
# CI reproducible.
